# Frontdesk Environment Configuration Template
# For Railway deployment, add these variables to your Backend Service Settings.

# Database Configuration (MySQL / MariaDB)
# Railway MySQL mapping:
# DB_HOST: ${{MySQL.MYSQLHOST}}
# DB_PORT: ${{MySQL.MYSQLPORT}}
# DB_NAME: ${{MySQL.MYSQLDATABASE}}
# DB_USER: ${{MySQL.MYSQLUSER}}
# DB_PASSWORD: ${{MySQL.MYSQLPASSWORD}}
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=frontdesk
DB_USER=frontdesk
DB_PASSWORD=replace-with-your-database-password

# Application Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Cookie Security
# Set to true in production behind HTTPS (Railway / Vercel)
SESSION_COOKIE_SECURE=true

# Public Portal URL
# Used to generate customer links in notification emails (your Vercel frontend URL)
FRONTDESK_PUBLIC_URL=https://your-frontend.vercel.app

# Outbound Email Notifications (Optional)
FRONTDESK_SMTP_HOST=smtp.example.com
FRONTDESK_SMTP_PORT=587
FRONTDESK_SMTP_SECURITY=starttls
FRONTDESK_SMTP_FROM=support@example.com
FRONTDESK_SMTP_USER=
FRONTDESK_SMTP_PASSWORD=
