# Database Configuration (MySQL / MariaDB)
# When deploying on Railway, map these to your Railway MySQL service variables
# e.g. using Railway References: ${{MySQL.MYSQLHOST}}, ${{MySQL.MYSQLPORT}}, etc.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=frontdesk
DB_USER=frontdesk
DB_PASSWORD=replace-with-your-database-password

# Optional: Administrator password for non-interactive schema migrations
# DB_MIGRATION_PASSWORD=replace-with-your-admin-password

# Application Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Cookie Security
# Set to true in production behind HTTPS (e.g. Railway / Vercel)
# Set to false only for local HTTP development
SESSION_COOKIE_SECURE=true

# Public Portal URL
# Used to generate customer links in notification emails (e.g. your Vercel deployment URL)
FRONTDESK_PUBLIC_URL=https://your-frontend.vercel.app

# Outbound SMTP Notifications (Optional)
# Configure these to deliver queued reply and verification emails
FRONTDESK_SMTP_HOST=smtp.example.com
FRONTDESK_SMTP_PORT=587
FRONTDESK_SMTP_SECURITY=starttls
FRONTDESK_SMTP_FROM=support@example.com
FRONTDESK_SMTP_USER=
FRONTDESK_SMTP_PASSWORD=
